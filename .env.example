# ================================================
# SOP 防呆系统 — Docker Compose 环境变量模板
# 使用方法: cp .env.example .env 然后修改下列值
# ================================================

# ---- 数据库 (PostgreSQL) ----
DB_PASSWORD=changeme_strong_password_here

# ---- Redis ----
REDIS_PASSWORD=changeme_redis_password

# ---- MinIO (对象存储) ----
MINIO_PASSWORD=changeme_minio_password

# ---- JWT 密钥 (至少 32 字符的随机字符串) ----
SOP_JWT_SECRET=changeme_jwt_secret_at_least_32_chars

# ---- CORS 允许的前端源 ----
CORS_ORIGINS=["http://localhost:8080"]

# ---- Grafana 管理员密码 ----
GRAFANA_PASSWORD=changeme_grafana_password
