# SOP 防呆系统环境变量模板
# 复制为 .env 后修改

# === 数据库 ===
DB_PASSWORD=changeme
SOP_DATABASE_URL=postgresql+asyncpg://sop_admin:changeme@localhost:5432/sop_pokayoke

# === Redis ===
SOP_REDIS_URL=redis://localhost:6379/0

# === MinIO ===
MINIO_PASSWORD=changeme
SOP_MINIO_ENDPOINT=localhost:9000
SOP_MINIO_ACCESS_KEY=minioadmin
SOP_MINIO_SECRET_KEY=changeme
SOP_MINIO_BUCKET_VIDEOS=sop-videos

# === MQTT ===
SOP_MQTT_BROKER_HOST=localhost
SOP_MQTT_BROKER_PORT=1883

# === MQTT（续） ===
SOP_MQTT_TOPIC_PREFIX=sop

# === 边缘端 ===
SOP_RTSP_URL=rtsp://admin:password@192.168.1.64:554/Streaming/Channels/101
SOP_STATION_ID=ST-01
SOP_USE_GSTREAMER=0
SOP_DEBOUNCE_SEC=0.5
SOP_APP_VERSION=1.0.0

# === 边缘端（续） ===
SOP_YOLO_MODEL=yolo11n.pt

# === VLM ===
SOP_OLLAMA_URL=http://localhost:11434
SOP_VLM_MODEL=qwen2-vl:2b

# === 前端 ===
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000

# === Grafana ===
GRAFANA_PASSWORD=changeme
