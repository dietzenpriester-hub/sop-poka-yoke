# SOP 防呆系统环境变量模板
# 复制为 .env 后修改
#
# ⚠️ 生产环境部署前，必须替换所有 "changeme" 为强密码！
# ⚠️ 切勿直接使用本文件中的默认密码用于生产环境！

# === 数据库 ===
DB_PASSWORD=changeme
SOP_DATABASE_URL=postgresql+asyncpg://sop_admin:changeme@localhost:5432/sop_pokayoke

# === Redis ===
REDIS_PASSWORD=changeme
SOP_REDIS_URL=redis://:changeme@localhost:6379/0

# === MinIO ===
MINIO_PASSWORD=changeme
SOP_MINIO_ENDPOINT=localhost:9000
SOP_MINIO_ACCESS_KEY=minioadmin
SOP_MINIO_SECRET_KEY=changeme
SOP_MINIO_BUCKET_VIDEOS=sop-videos

# === MQTT ===
SOP_MQTT_BROKER_HOST=localhost
SOP_MQTT_BROKER_PORT=1883

# === MQTT（续） ===
SOP_MQTT_TOPIC_PREFIX=sop
SOP_MQTT_USERNAME=
SOP_MQTT_PASSWORD=

# === JWT（生产必填） ===
# ⚠️ 生产环境必须替换为强随机密钥（至少 32 字符）
JWT_SECRET=sop-pokayoke-secret-key-change-in-production
SOP_JWT_SECRET=sop-pokayoke-secret-key-change-in-production

# === CORS ===
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# === 边缘端 ===
# ⚠️ 请替换为实际摄像头地址和凭证，勿提交真实密码
SOP_RTSP_URL=rtsp://USER:PASSWORD@camera-host:554/Streaming/Channels/101
SOP_STATION_ID=ST-01
SOP_USE_GSTREAMER=0
SOP_DEBOUNCE_SEC=0.5
SOP_APP_VERSION=1.0.0

# === 边缘端（续） ===
SOP_YOLO_MODEL=yolo11n.pt

# === VLM ===
SOP_OLLAMA_URL=http://localhost:11434
SOP_VLM_MODEL=qwen2.5vl:3b

# === 前端 ===
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000

# === Grafana ===
GRAFANA_PASSWORD=changeme
